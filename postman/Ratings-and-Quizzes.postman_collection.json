{
  "info": {
    "name": "Ratings and Quizzes",
    "description": "Person 3 requests: ratings, interactions, personality quiz and mood quiz. Run the folders top to bottom. Needs test user id 1 and book id 1 in the database. Set the token variable after login once JWT is merged.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ratings",
      "item": [
        {
          "name": "1. Rate a book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"ratingId\", pm.response.json().id);",
                  "pm.test(\"Score is 4\", function () { pm.expect(pm.response.json().score).to.eql(4); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ratings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ratings"
              ]
            },
            "description": "Creates a rating. Saves the new rating id in the ratingId variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": 1,\n  \"score\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Rate the same book again (duplicate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error format has message\", function () { pm.expect(pm.response.json()).to.have.property(\"message\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ratings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ratings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": 1,\n  \"score\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Invalid score (6)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ratings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ratings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": 2,\n  \"score\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. Change the score",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Score is 2\", function () { pm.expect(pm.response.json().score).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ratings/{{ratingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ratings",
                "{{ratingId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. List a user's ratings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Page has content\", function () { pm.expect(pm.response.json()).to.have.property(\"content\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1/ratings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "1",
                "ratings"
              ]
            }
          }
        },
        {
          "name": "6. Delete the rating",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ratings/{{ratingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ratings",
                "{{ratingId}}"
              ]
            }
          }
        }
      ]
    },
